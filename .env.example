# ── Required ────────────────────────────────────────────────
# Postgres database (Neon / Supabase / Vercel Postgres)
DATABASE_URL=postgresql://postgres@127.0.0.1:5432/almrkz
# Long random text (e.g. `openssl rand -hex 32`). Never share it.
PAYLOAD_SECRET=change-me
# The public address of the site (no trailing slash)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# ── Media storage (production) — choose ONE ─────────────────
# Vercel Blob (simplest on Vercel: Storage → Blob → Connect)
BLOB_READ_WRITE_TOKEN=
# …or any S3-compatible bucket (AWS S3, Cloudflare R2, …)
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── Email (new-lead notifications, password reset) ──────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_ADDRESS=no-reply@almrkz.net
EMAIL_FROM_NAME=كلية المركز — الموقع
# Fallback recipient if none is set in «إعدادات الموقع»
LEADS_NOTIFY_EMAIL=

# ── Seed (npm run seed) — first admin account ───────────────
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
