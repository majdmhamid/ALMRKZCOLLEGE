# انسخ هذا الملف باسم .env.local وعبّي القيم (الملف .env.local لا يُرفع على GitHub)

# الرابط النهائي للموقع (يُستخدم في SEO وخريطة الموقع)
NEXT_PUBLIC_SITE_URL=https://www.almrkz.net

# إرسال استمارة "سجّل اهتمامك" بالإيميل عبر Resend (https://resend.com)
# بدون هذه المفاتيح تُطبع الطلبات في سجل الخادم فقط.
RESEND_API_KEY=
LEAD_TO_EMAIL=almerkaz.collega@gmail.com
LEAD_FROM_EMAIL=

# أدوات القياس (تُفعَّل فقط عند تعبئتها) — انظر src/components/Analytics.tsx
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# ───────── لوحة التحكم (/admin) + التوقيع الإلكتروني (/sign) ─────────
# الدخول للوحة: حساب Supabase إله صف بجدول admin_profiles (`npm run admin:create`).
# بدون Supabase على جهاز التطوير: وضع تجريبي تلقائي (بيانات وهمية بمجلد .mock-data و .cms-data)،
# والدخول بـ MOCK_ADMIN_EMAIL / MOCK_ADMIN_PASSWORD تحت.

# عنوان الموقع اللي بيدخل بروابط التوقيع اللي بتنبعت للعملاء
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase → Project Settings → API
#   NEXT_PUBLIC_SUPABASE_URL       = Project URL
#   NEXT_PUBLIC_SUPABASE_ANON_KEY  = anon / publishable key (آمن للمتصفح)
#   SUPABASE_SERVICE_ROLE_KEY      = service_role / secret key (سرّي جداً — للسيرفر بس)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase → Connect → "Transaction pooler" (مع كلمة سر قاعدة البيانات) — للسيرفر ولـ `npm run db:migrate`
SUPABASE_DB_URL=

# مفاتيح سرّية — `npm run secrets` بيعبّيها لحاله. ⚠️ لا تغيّرها بعد ما تبلّش تستعمل التوقيع:
#   ID_HMAC_SECRET → أرقام الهويات المحفوظة · TOKEN_ENC_KEY → نسخ الروابط القديمة · SESSION_SECRET → جلسات الدخول
ID_HMAC_SECRET=
TOKEN_ENC_KEY=
SESSION_SECRET=

# وضع تجريبي بالقوة حتى لو في Supabase: MOCK_BACKEND=1  (أو `npm run dev:mock`)
# MOCK_BACKEND=1
MOCK_ADMIN_EMAIL=admin@example.test
MOCK_ADMIN_PASSWORD=mock-password
