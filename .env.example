# ── Required ────────────────────────────────────────────────
# Postgres database. Recommended: Supabase (the same project also holds the e-signature data).
# Supabase → Connect → "Transaction pooler" connection string (port 6543). Not "Direct connection"
# (Vercel can't reach it). Schema changes: `npm run migrate` (never push — see payload.config.ts).
DATABASE_URL=postgresql://postgres@127.0.0.1:5432/almrkz
# Filled by `npm run secrets`. Must stay the same forever (changing it logs everyone out).
# Before a deploy, `npm run check:env` checks all of these (it runs by itself on Vercel).
# If empty (local try-out only) it is derived from DATABASE_URL.
PAYLOAD_SECRET=
# The public address of the site (no trailing slash). Detected automatically on Vercel.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# ── Media storage (production) — choose ONE ─────────────────
# Vercel Blob (simplest on Vercel: Storage → Blob → Connect)
BLOB_READ_WRITE_TOKEN=
# …or any S3-compatible bucket (Supabase Storage, AWS S3, Cloudflare R2, …)
# Supabase: Storage → create a PUBLIC bucket "media" → Settings → S3 access keys;
#   S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3  S3_REGION=<project region, e.g. eu-central-1>
# Admin uploads go straight from the browser to the bucket (clientUploads), so videos over
# Vercel's 4.5 MB request limit work. Check once after launch: upload a video > 5 MB in /admin.
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── Email (new-lead notifications, password reset) ──────────
# Now: the college Gmail + a Google App Password (SMTP_HOST=smtp.gmail.com, SMTP_USER and
#   EMAIL_FROM_ADDRESS = that Gmail). Later, with our own domain: Resend over SMTP
#   (SMTP_HOST=smtp.resend.com, SMTP_USER=resend, SMTP_PASS=<API key>). No code change.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_ADDRESS=no-reply@almrkz.net
EMAIL_FROM_NAME=كلية المركز — الموقع
# Fallback recipient if none is set in «إعدادات الموقع»
LEADS_NOTIFY_EMAIL=

# ── Statistics & ads measurement (optional) — docs/إحصائيات-وكوكيز.md ──
# Empty = nothing loads: no cookie banner, no Google/Meta scripts, no cookies.
# Set = visitors see a cookie banner («موافق» / «رفض»); the tools load only after «موافق».
# NEXT_PUBLIC_* values are baked in when the site is built → after changing them on Vercel: Redeploy.
# Google Analytics 4 → Admin → Data streams → Web → Measurement ID (G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=
# Meta Events Manager → the Pixel (dataset) → its ID (digits only)
NEXT_PUBLIC_META_PIXEL_ID=
# Google Search Console → verify with "HTML tag" → only the content="…" value (a meta tag; no cookies)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ── Seed (npm run seed) — first admin account ───────────────
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# ── E-signature (/admin/documents, /sign/...) ───────────────
# Without NEXT_PUBLIC_SUPABASE_URL (and not on Vercel) the e-signature part runs in a local
# try-out mode (fake data in .mock-data). On Vercel it needs Supabase — same project as above.
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Supabase → Connect → "Transaction pooler" — the same URL as DATABASE_URL
SUPABASE_DB_URL=
# Public address used in the signing links sent to clients (same as NEXT_PUBLIC_SERVER_URL)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Secrets — `npm run secrets` fills them. Never change them once the signing system is in use.
TOKEN_ENC_KEY=
SESSION_SECRET=
# Vercel Cron → /api/payload-jobs/run (news «schedule publish»). `npm run secrets` fills it.
CRON_SECRET=
# Force the local try-out mode even when Supabase is set (never on Vercel — npm run check:env stops it):
# MOCK_BACKEND=1
