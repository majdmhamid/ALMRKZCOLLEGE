# انسخ هذا الملف باسم .env.local وعبّي القيم. الملف .env.local لا يُرفع على GitHub.
# Copy to .env.local. Never commit .env.local.

# ---------------------------------------------------------------------------
# عنوان التطبيق — بيدخل بروابط التوقيع اللي بتنبعت للعملاء
# Public base URL used to build signing links
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3100

# ---------------------------------------------------------------------------
# Supabase → Project Settings → API
#   NEXT_PUBLIC_SUPABASE_URL       = Project URL
#   NEXT_PUBLIC_SUPABASE_ANON_KEY  = anon / publishable key (آمن للمتصفح)
#   SUPABASE_SERVICE_ROLE_KEY      = service_role / secret key (سرّي جداً — للسيرفر بس)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase → Connect → "Session pooler" connection string (مع كلمة سر قاعدة البيانات)
# Used only by `npm run db:migrate` on your computer. Not needed on Vercel.
SUPABASE_DB_URL=

# ---------------------------------------------------------------------------
# مفاتيح سرّية — `npm run secrets` بيعبّيها لحاله.
# ⚠️ لا تغيّرها بعد ما تبلّش تستعمل التطبيق:
#   تغيير ID_HMAC_SECRET  → أرقام الهويات المحفوظة ما عادت تتطابق
#   تغيير TOKEN_ENC_KEY    → ما بتقدر تنسخ الروابط القديمة مرة ثانية (بتعمل رابط جديد)
#   تغيير SESSION_SECRET   → بس العملاء اللي بنص التوقيع بيرجعوا يدخلوا الهوية
# ---------------------------------------------------------------------------
ID_HMAC_SECRET=
TOKEN_ENC_KEY=
SESSION_SECRET=

# ---------------------------------------------------------------------------
# وضع تجريبي بدون Supabase (بيانات وهمية على الكمبيوتر) — للتطوير والصور فقط
# Mock backend for local UI work: `npm run dev:mock`
# ---------------------------------------------------------------------------
# MOCK_BACKEND=1
MOCK_ADMIN_EMAIL=admin@example.test
MOCK_ADMIN_PASSWORD=mock-password
